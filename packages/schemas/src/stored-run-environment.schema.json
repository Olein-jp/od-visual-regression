{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "environment_version",
    "wordpress",
    "php",
    "theme",
    "parent_theme",
    "plugins",
    "mu_plugins",
    "locale",
    "site_url",
    "runner",
    "playwright",
    "chromium",
    "completion"
  ],
  "properties": {
    "environment_version": {
      "const": 1
    },
    "wordpress": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "php": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "parent_theme": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "version": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "version": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "mu_plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "version": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "minItems": 0,
      "maxItems": 1000
    },
    "locale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "site_url": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048
    },
    "runner": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        {
          "type": "null"
        }
      ]
    },
    "playwright": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        {
          "type": "null"
        }
      ]
    },
    "chromium": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        {
          "type": "null"
        }
      ]
    },
    "completion": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "digest",
            "request",
            "response"
          ],
          "properties": {
            "digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
            },
            "request": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "schema_version",
                "runner_execution_id",
                "versions",
                "outcome",
                "error_code",
                "error_message"
              ],
              "properties": {
                "schema_version": {
                  "const": 1
                },
                "runner_execution_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "versions": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "runner",
                    "playwright",
                    "chromium"
                  ],
                  "properties": {
                    "runner": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "playwright": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    "chromium": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    }
                  }
                },
                "outcome": {
                  "enum": [
                    "finished",
                    "failed"
                  ]
                },
                "error_code": {
                  "anyOf": [
                    {
                      "enum": [
                        "SNAPSHOT_FAILED",
                        "NAVIGATION_FAILED",
                        "HTTP_ERROR",
                        "CAPTURE_FAILED",
                        "CONTEXT_CLOSE_FAILED",
                        "RUN_ABORTED",
                        "RUN_DEADLINE_EXCEEDED",
                        "DISPATCH_TIMEOUT"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "error_message": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "outcome": {
                        "const": "finished"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "error_code": {
                        "type": "null"
                      },
                      "error_message": {
                        "type": "null"
                      }
                    }
                  },
                  "else": {
                    "properties": {
                      "error_code": {
                        "enum": [
                          "SNAPSHOT_FAILED",
                          "NAVIGATION_FAILED",
                          "HTTP_ERROR",
                          "CAPTURE_FAILED",
                          "CONTEXT_CLOSE_FAILED",
                          "RUN_ABORTED",
                          "RUN_DEADLINE_EXCEEDED",
                          "DISPATCH_TIMEOUT"
                        ]
                      },
                      "error_message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500
                      }
                    }
                  }
                }
              ]
            },
            "response": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "schema_version",
                "run_uuid",
                "status",
                "total_snapshots",
                "completed_snapshots",
                "error_snapshots",
                "pending_snapshots",
                "completed_at",
                "error_code"
              ],
              "properties": {
                "schema_version": {
                  "const": 1
                },
                "run_uuid": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$(?![\\s\\S])"
                },
                "status": {
                  "enum": [
                    "queued",
                    "running",
                    "complete",
                    "partial",
                    "failed",
                    "deleting"
                  ]
                },
                "total_snapshots": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000
                },
                "completed_snapshots": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000
                },
                "error_snapshots": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000
                },
                "pending_snapshots": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000
                },
                "completed_at": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$(?![\\s\\S])"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "error_code": {
                  "anyOf": [
                    {
                      "enum": [
                        "SNAPSHOT_FAILED",
                        "NAVIGATION_FAILED",
                        "HTTP_ERROR",
                        "CAPTURE_FAILED",
                        "CONTEXT_CLOSE_FAILED",
                        "RUN_ABORTED",
                        "RUN_DEADLINE_EXCEEDED",
                        "DISPATCH_TIMEOUT"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://odvr.example/schemas/stored-run-environment.schema.json"
}
