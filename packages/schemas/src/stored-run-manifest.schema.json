{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://odvr.example/schemas/stored-run-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite",
    "targets",
    "devices",
    "settings",
    "reference",
    "allowed_origins",
    "queued_deadline_at",
    "http_auth_origin"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "url",
          "label",
          "object_id",
          "post_type"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "url": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048
          },
          "label": {
            "type": "string",
            "minLength": 0,
            "maxLength": 200
          },
          "object_id": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              {
                "type": "null"
              }
            ]
          },
          "post_type": {
            "type": "string",
            "minLength": 0,
            "maxLength": 20
          }
        }
      },
      "minItems": 1,
      "maxItems": 100
    },
    "devices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "slug",
          "viewport_width",
          "viewport_height",
          "device_scale_factor",
          "is_mobile",
          "has_touch"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,49}$(?![\\s\\S])"
          },
          "viewport_width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          "viewport_height": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          "device_scale_factor": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 4
          },
          "is_mobile": {
            "type": "boolean"
          },
          "has_touch": {
            "type": "boolean"
          },
          "user_agent": {
            "type": "string",
            "maxLength": 1000
          }
        }
      },
      "minItems": 1,
      "maxItems": 10
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "navigation_timeout_ms",
        "image_timeout_ms",
        "lazy_load",
        "concurrency",
        "pixel_threshold",
        "review_threshold",
        "changed_threshold",
        "ignore_selectors",
        "settings_version"
      ],
      "properties": {
        "navigation_timeout_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 120000
        },
        "image_timeout_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 60000
        },
        "lazy_load": {
          "type": "boolean"
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "pixel_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "review_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "changed_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ignore_selectors": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "settings_version": {
          "const": 1
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "run_id",
        "snapshots",
        "versions"
      ],
      "properties": {
        "mode": {
          "enum": [
            "pinned",
            "previous",
            "specific"
          ]
        },
        "run_id": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshots": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "target_id",
              "device_id",
              "baseline_snapshot_id",
              "reason"
            ],
            "properties": {
              "target_id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              "device_id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              "baseline_snapshot_id": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reason": {
                "anyOf": [
                  {
                    "enum": [
                      "no_reference",
                      "new_target",
                      "new_device",
                      "incompatible",
                      "missing",
                      "corrupt"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "minItems": 1,
          "maxItems": 1000
        },
        "versions": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "runner",
                "playwright",
                "chromium"
              ],
              "properties": {
                "runner": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "playwright": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "chromium": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "allowed_origins": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri",
        "maxLength": 2048
      },
      "minItems": 1,
      "maxItems": 30,
      "uniqueItems": true
    },
    "queued_deadline_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$(?![\\s\\S])"
    },
    "http_auth_origin": {
      "anyOf": [
        {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
