{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://odvr.example/schemas/settings-response.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "item"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dispatcher_url",
        "site_id",
        "retention",
        "queued_timeout_seconds",
        "run_timeout_seconds",
        "dispatcher_secret_configured",
        "http_auth_configured",
        "http_auth_origin",
        "retained_runs",
        "storage_bytes",
        "deletion_failures"
      ],
      "properties": {
        "dispatcher_url": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "site_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,100}$(?![\\s\\S])"
        },
        "retention": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "count"
          ],
          "properties": {
            "mode": {
              "enum": [
                "all",
                "last"
              ]
            },
            "count": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 2147483647
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "queued_timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7199
        },
        "run_timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7199
        },
        "dispatcher_secret_configured": {
          "type": "boolean"
        },
        "http_auth_configured": {
          "type": "boolean"
        },
        "http_auth_origin": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri",
              "maxLength": 2048
            },
            {
              "type": "null"
            }
          ]
        },
        "retained_runs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "storage_bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "deletion_failures": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      }
    }
  }
}
