{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://odvr.example/schemas/run-response.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "item"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "run_uuid",
        "suite_id",
        "suite_name",
        "status",
        "created_at",
        "deadline_at",
        "completed_at",
        "total_snapshots",
        "completed_snapshots",
        "error_snapshots",
        "pending_snapshots",
        "error_code",
        "error_message",
        "reference_run_id",
        "environment",
        "reference_environment",
        "targets",
        "devices",
        "settings",
        "protection",
        "deletion_error"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "run_uuid": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$(?![\\s\\S])"
        },
        "suite_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "suite_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "status": {
          "enum": [
            "queued",
            "running",
            "complete",
            "partial",
            "failed",
            "deleting"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$(?![\\s\\S])"
        },
        "deadline_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$(?![\\s\\S])"
        },
        "completed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "total_snapshots": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "completed_snapshots": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "error_snapshots": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "pending_snapshots": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "error_code": {
          "anyOf": [
            {
              "enum": [
                "SNAPSHOT_FAILED",
                "NAVIGATION_FAILED",
                "HTTP_ERROR",
                "CAPTURE_FAILED",
                "CONTEXT_CLOSE_FAILED",
                "RUN_ABORTED",
                "RUN_DEADLINE_EXCEEDED",
                "DISPATCH_TIMEOUT"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "error_message": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            {
              "type": "null"
            }
          ]
        },
        "reference_run_id": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            {
              "type": "null"
            }
          ]
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "environment_version",
            "wordpress",
            "php",
            "theme",
            "parent_theme",
            "plugins",
            "mu_plugins",
            "locale",
            "site_url",
            "runner",
            "playwright",
            "chromium"
          ],
          "properties": {
            "environment_version": {
              "const": 1
            },
            "wordpress": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "php": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "theme": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "version"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "version": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            "parent_theme": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "version"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "version": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "plugins": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "name",
                  "version"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "version": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              },
              "minItems": 0,
              "maxItems": 1000
            },
            "mu_plugins": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "name",
                  "version"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "version": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              },
              "minItems": 0,
              "maxItems": 1000
            },
            "locale": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "site_url": {
              "type": "string",
              "format": "uri",
              "maxLength": 2048
            },
            "runner": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                {
                  "type": "null"
                }
              ]
            },
            "playwright": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                {
                  "type": "null"
                }
              ]
            },
            "chromium": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "reference_environment": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "environment_version",
                "wordpress",
                "php",
                "theme",
                "parent_theme",
                "plugins",
                "mu_plugins",
                "locale",
                "site_url",
                "runner",
                "playwright",
                "chromium"
              ],
              "properties": {
                "environment_version": {
                  "const": 1
                },
                "wordpress": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "php": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "theme": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "name",
                    "version"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "version": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  }
                },
                "parent_theme": {
                  "anyOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "name",
                        "version"
                      ],
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200
                        },
                        "version": {
                          "anyOf": [
                            {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 100
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "plugins": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "name",
                      "version"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "version": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 100
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    }
                  },
                  "minItems": 0,
                  "maxItems": 1000
                },
                "mu_plugins": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "name",
                      "version"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "version": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 100
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    }
                  },
                  "minItems": 0,
                  "maxItems": 1000
                },
                "locale": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "site_url": {
                  "type": "string",
                  "format": "uri",
                  "maxLength": 2048
                },
                "runner": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "playwright": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "chromium": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "url",
              "label",
              "object_id",
              "post_type"
            ],
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              "url": {
                "type": "string",
                "format": "uri",
                "maxLength": 2048
              },
              "label": {
                "type": "string",
                "minLength": 0,
                "maxLength": 200
              },
              "object_id": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "post_type": {
                "type": "string",
                "minLength": 0,
                "maxLength": 20
              }
            }
          },
          "minItems": 1,
          "maxItems": 100
        },
        "devices": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "slug",
              "viewport_width",
              "viewport_height",
              "device_scale_factor",
              "is_mobile",
              "has_touch"
            ],
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "slug": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,49}$(?![\\s\\S])"
              },
              "viewport_width": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4096
              },
              "viewport_height": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4096
              },
              "device_scale_factor": {
                "type": "number",
                "minimum": 0.1,
                "maximum": 4
              },
              "is_mobile": {
                "type": "boolean"
              },
              "has_touch": {
                "type": "boolean"
              },
              "user_agent": {
                "type": "string",
                "maxLength": 1000
              }
            }
          },
          "minItems": 1,
          "maxItems": 10
        },
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "navigation_timeout_ms",
            "image_timeout_ms",
            "lazy_load",
            "concurrency",
            "pixel_threshold",
            "review_threshold",
            "changed_threshold",
            "ignore_selectors",
            "settings_version"
          ],
          "properties": {
            "navigation_timeout_ms": {
              "type": "integer",
              "minimum": 100,
              "maximum": 120000
            },
            "image_timeout_ms": {
              "type": "integer",
              "minimum": 100,
              "maximum": 60000
            },
            "lazy_load": {
              "type": "boolean"
            },
            "concurrency": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4
            },
            "pixel_threshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "review_threshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "changed_threshold": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "ignore_selectors": {
              "type": "array",
              "maxItems": 50,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            },
            "settings_version": {
              "const": 1
            }
          }
        },
        "protection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reasons",
            "referenced_by"
          ],
          "properties": {
            "reasons": {
              "type": "array",
              "items": {
                "enum": [
                  "pinned",
                  "active",
                  "referenced"
                ]
              },
              "minItems": 0,
              "maxItems": 3,
              "uniqueItems": true
            },
            "referenced_by": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "run_uuid",
                  "status",
                  "created_at"
                ],
                "properties": {
                  "id": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647
                  },
                  "run_uuid": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$(?![\\s\\S])"
                  },
                  "status": {
                    "enum": [
                      "queued",
                      "running",
                      "complete",
                      "partial",
                      "failed",
                      "deleting"
                    ]
                  },
                  "created_at": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$(?![\\s\\S])"
                  }
                }
              },
              "minItems": 0,
              "maxItems": 1000
            }
          }
        },
        "deletion_error": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
