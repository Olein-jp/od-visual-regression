{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://odvr.example/schemas/run-state.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_uuid",
    "status",
    "total_snapshots",
    "completed_snapshots",
    "error_snapshots",
    "pending_snapshots",
    "completed_at",
    "error_code"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$(?![\\s\\S])"
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "complete",
        "partial",
        "failed",
        "deleting"
      ]
    },
    "total_snapshots": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "completed_snapshots": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "error_snapshots": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "pending_snapshots": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "completed_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "error_code": {
      "anyOf": [
        {
          "enum": [
            "SNAPSHOT_FAILED",
            "NAVIGATION_FAILED",
            "HTTP_ERROR",
            "CAPTURE_FAILED",
            "CONTEXT_CLOSE_FAILED",
            "RUN_ABORTED",
            "RUN_DEADLINE_EXCEEDED",
            "DISPATCH_TIMEOUT"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
