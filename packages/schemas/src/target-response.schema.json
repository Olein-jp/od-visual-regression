{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://odvr.example/schemas/target-response.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "item"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "url",
        "label",
        "object_id",
        "post_type",
        "suite_id",
        "enabled",
        "sort_order"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "url": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "label": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200
        },
        "object_id": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            {
              "type": "null"
            }
          ]
        },
        "post_type": {
          "type": "string",
          "minLength": 0,
          "maxLength": 20
        },
        "suite_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "enabled": {
          "type": "boolean"
        },
        "sort_order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      }
    }
  }
}
