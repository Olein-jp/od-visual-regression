{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://odvr.example/schemas/settings-patch-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "dispatcher_url": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048
    },
    "site_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,100}$(?![\\s\\S])"
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "count"
      ],
      "properties": {
        "mode": {
          "enum": [
            "all",
            "last"
          ]
        },
        "count": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "queued_timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7199
    },
    "run_timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 7199
    }
  },
  "minProperties": 2
}
