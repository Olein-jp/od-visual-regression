{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://odvr.example/schemas/dispatch-response.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "site_id",
    "run_uuid",
    "status",
    "runner_execution_id"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "site_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,100}$(?![\\s\\S])"
    },
    "run_uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$(?![\\s\\S])"
    },
    "status": {
      "enum": [
        "accepted",
        "started"
      ]
    },
    "runner_execution_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
