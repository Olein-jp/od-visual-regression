{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://odvr.example/schemas/connection-test-response.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "item"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checks",
        "checked_at",
        "code",
        "message"
      ],
      "properties": {
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "settings",
            "storage",
            "dispatcher"
          ],
          "properties": {
            "settings": {
              "enum": [
                "passed",
                "failed"
              ]
            },
            "storage": {
              "enum": [
                "passed",
                "failed"
              ]
            },
            "dispatcher": {
              "enum": [
                "passed",
                "failed"
              ]
            }
          }
        },
        "checked_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$(?![\\s\\S])"
        },
        "code": {
          "type": "string",
          "pattern": "^odvr_[a-z0-9_]+$(?![\\s\\S])"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    }
  }
}
