{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://odvr.example/schemas/prototype-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "targets",
    "devices",
    "settings",
    "allowed_origins"
  ],
  "properties": {
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "url",
          "label"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "url": {
            "type": "string",
            "format": "uri",
            "maxLength": 2048
          },
          "label": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    "devices": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "slug",
          "viewport_width",
          "viewport_height",
          "device_scale_factor",
          "is_mobile",
          "has_touch"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,49}$"
          },
          "viewport_width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          "viewport_height": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          "device_scale_factor": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 4
          },
          "is_mobile": {
            "type": "boolean"
          },
          "has_touch": {
            "type": "boolean"
          },
          "user_agent": {
            "type": "string",
            "maxLength": 1000
          }
        }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "navigation_timeout_ms",
        "image_timeout_ms",
        "lazy_load",
        "concurrency",
        "pixel_threshold",
        "review_threshold",
        "changed_threshold",
        "ignore_selectors"
      ],
      "properties": {
        "navigation_timeout_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 120000
        },
        "image_timeout_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 60000
        },
        "lazy_load": {
          "type": "boolean"
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "pixel_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "review_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "changed_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ignore_selectors": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "allowed_origins": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri"
      }
    }
  }
}
