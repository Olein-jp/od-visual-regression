{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://odvr.example/schemas/snapshot-metadata.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadata_version",
    "target",
    "device",
    "reference",
    "image_sha256",
    "diff_sha256",
    "result_digest",
    "result"
  ],
  "properties": {
    "metadata_version": {
      "const": 1
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "url",
        "label",
        "object_id",
        "post_type"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "url": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        },
        "label": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200
        },
        "object_id": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            {
              "type": "null"
            }
          ]
        },
        "post_type": {
          "type": "string",
          "minLength": 0,
          "maxLength": 20
        }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "slug",
        "viewport_width",
        "viewport_height",
        "device_scale_factor",
        "is_mobile",
        "has_touch"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,49}$(?![\\s\\S])"
        },
        "viewport_width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "viewport_height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "device_scale_factor": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 4
        },
        "is_mobile": {
          "type": "boolean"
        },
        "has_touch": {
          "type": "boolean"
        },
        "user_agent": {
          "type": "string",
          "maxLength": 1000
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "device_id",
        "baseline_snapshot_id",
        "reason"
      ],
      "properties": {
        "target_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "device_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "baseline_snapshot_id": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "anyOf": [
            {
              "enum": [
                "no_reference",
                "new_target",
                "new_device",
                "incompatible",
                "missing",
                "corrupt"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "image_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "diff_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "result_digest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "result": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "target_id",
            "device_id",
            "status",
            "width",
            "height",
            "baseline_width",
            "baseline_height",
            "dimension_changed",
            "diff_pixels",
            "total_pixels",
            "diff_ratio",
            "duration_ms",
            "http_status",
            "error_code",
            "error_message",
            "no_baseline_reason"
          ],
          "properties": {
            "schema_version": {
              "const": 1
            },
            "target_id": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "device_id": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "status": {
              "enum": [
                "CAPTURED",
                "NO_BASELINE",
                "UNCHANGED",
                "REVIEW",
                "CHANGED",
                "ERROR"
              ]
            },
            "width": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 16384
                },
                {
                  "type": "null"
                }
              ]
            },
            "height": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 16384
                },
                {
                  "type": "null"
                }
              ]
            },
            "baseline_width": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 16384
                },
                {
                  "type": "null"
                }
              ]
            },
            "baseline_height": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 16384
                },
                {
                  "type": "null"
                }
              ]
            },
            "dimension_changed": {
              "type": "boolean"
            },
            "diff_pixels": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 40000000
                },
                {
                  "type": "null"
                }
              ]
            },
            "total_pixels": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 40000000
                },
                {
                  "type": "null"
                }
              ]
            },
            "diff_ratio": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "duration_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5400000
            },
            "http_status": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 100,
                  "maximum": 599
                },
                {
                  "type": "null"
                }
              ]
            },
            "error_code": {
              "anyOf": [
                {
                  "enum": [
                    "SNAPSHOT_FAILED",
                    "NAVIGATION_FAILED",
                    "HTTP_ERROR",
                    "CAPTURE_FAILED",
                    "CONTEXT_CLOSE_FAILED",
                    "RUN_ABORTED",
                    "RUN_DEADLINE_EXCEEDED",
                    "DISPATCH_TIMEOUT"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "error_message": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                },
                {
                  "type": "null"
                }
              ]
            },
            "no_baseline_reason": {
              "anyOf": [
                {
                  "enum": [
                    "new_target",
                    "new_device",
                    "incompatible",
                    "missing",
                    "corrupt"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "CAPTURED"
                  }
                }
              },
              "then": {
                "properties": {
                  "width": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 16384
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 16384
                  },
                  "error_code": {
                    "type": "null"
                  },
                  "error_message": {
                    "type": "null"
                  },
                  "no_baseline_reason": {
                    "type": "null"
                  },
                  "baseline_width": {
                    "type": "null"
                  },
                  "baseline_height": {
                    "type": "null"
                  },
                  "diff_pixels": {
                    "type": "null"
                  },
                  "total_pixels": {
                    "type": "null"
                  },
                  "diff_ratio": {
                    "type": "null"
                  },
                  "dimension_changed": {
                    "const": false
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "NO_BASELINE"
                  }
                }
              },
              "then": {
                "properties": {
                  "width": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 16384
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 16384
                  },
                  "error_code": {
                    "type": "null"
                  },
                  "error_message": {
                    "type": "null"
                  },
                  "no_baseline_reason": {
                    "enum": [
                      "new_target",
                      "new_device",
                      "incompatible",
                      "missing",
                      "corrupt"
                    ]
                  },
                  "baseline_width": {
                    "type": "null"
                  },
                  "baseline_height": {
                    "type": "null"
                  },
                  "diff_pixels": {
                    "type": "null"
                  },
                  "total_pixels": {
                    "type": "null"
                  },
                  "diff_ratio": {
                    "type": "null"
                  },
                  "dimension_changed": {
                    "const": false
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "UNCHANGED"
                  }
                }
              },
              "then": {
                "properties": {
                  "width": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 16384
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 16384
                  },
                  "error_code": {
                    "type": "null"
                  },
                  "error_message": {
                    "type": "null"
                  },
                  "no_baseline_reason": {
                    "type": "null"
                  },
                  "baseline_width": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 16384
                  },
                  "baseline_height": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 16384
                  },
                  "diff_pixels": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 40000000
                  },
                  "total_pixels": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 40000000
                  },
                  "diff_ratio": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "REVIEW"
                  }
                }
              },
              "then": {
                "properties": {
                  "width": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 16384
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 16384
                  },
                  "error_code": {
                    "type": "null"
                  },
                  "error_message": {
                    "type": "null"
                  },
                  "no_baseline_reason": {
                    "type": "null"
                  },
                  "baseline_width": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 16384
                  },
                  "baseline_height": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 16384
                  },
                  "diff_pixels": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 40000000
                  },
                  "total_pixels": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 40000000
                  },
                  "diff_ratio": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "CHANGED"
                  }
                }
              },
              "then": {
                "properties": {
                  "width": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 16384
                  },
                  "height": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 16384
                  },
                  "error_code": {
                    "type": "null"
                  },
                  "error_message": {
                    "type": "null"
                  },
                  "no_baseline_reason": {
                    "type": "null"
                  },
                  "baseline_width": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 16384
                  },
                  "baseline_height": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 16384
                  },
                  "diff_pixels": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 40000000
                  },
                  "total_pixels": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 40000000
                  },
                  "diff_ratio": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "ERROR"
                  }
                }
              },
              "then": {
                "properties": {
                  "width": {
                    "type": "null"
                  },
                  "height": {
                    "type": "null"
                  },
                  "baseline_width": {
                    "type": "null"
                  },
                  "baseline_height": {
                    "type": "null"
                  },
                  "diff_pixels": {
                    "type": "null"
                  },
                  "total_pixels": {
                    "type": "null"
                  },
                  "diff_ratio": {
                    "type": "null"
                  },
                  "no_baseline_reason": {
                    "type": "null"
                  },
                  "error_code": {
                    "enum": [
                      "SNAPSHOT_FAILED",
                      "NAVIGATION_FAILED",
                      "HTTP_ERROR",
                      "CAPTURE_FAILED",
                      "CONTEXT_CLOSE_FAILED",
                      "RUN_ABORTED",
                      "RUN_DEADLINE_EXCEEDED",
                      "DISPATCH_TIMEOUT"
                    ]
                  },
                  "error_message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "dimension_changed": {
                    "const": false
                  }
                }
              }
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
