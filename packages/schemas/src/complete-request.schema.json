{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://odvr.example/schemas/complete-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "runner_execution_id",
    "versions",
    "outcome",
    "error_code",
    "error_message"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "runner_execution_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runner",
        "playwright",
        "chromium"
      ],
      "properties": {
        "runner": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "playwright": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "chromium": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      }
    },
    "outcome": {
      "enum": [
        "finished",
        "failed"
      ]
    },
    "error_code": {
      "anyOf": [
        {
          "enum": [
            "SNAPSHOT_FAILED",
            "NAVIGATION_FAILED",
            "HTTP_ERROR",
            "CAPTURE_FAILED",
            "CONTEXT_CLOSE_FAILED",
            "RUN_ABORTED",
            "RUN_DEADLINE_EXCEEDED",
            "DISPATCH_TIMEOUT"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "error_message": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "finished"
          }
        }
      },
      "then": {
        "properties": {
          "error_code": {
            "type": "null"
          },
          "error_message": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "error_code": {
            "enum": [
              "SNAPSHOT_FAILED",
              "NAVIGATION_FAILED",
              "HTTP_ERROR",
              "CAPTURE_FAILED",
              "CONTEXT_CLOSE_FAILED",
              "RUN_ABORTED",
              "RUN_DEADLINE_EXCEEDED",
              "DISPATCH_TIMEOUT"
            ]
          },
          "error_message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    }
  ]
}
