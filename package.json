{
  "name": "od-visual-regression",
  "version": "0.1.0",
  "private": true,
  "description": "OD Visual Regression の WordPress・Runner モノレポ",
  "scripts": {
    "build:plugin": "bash scripts/build-plugin.sh",
    "test:plugin-build": "python3 -m unittest discover -s scripts/tests -p 'test_build_plugin.py'",
    "env:start": "wp-env start",
    "env:stop": "wp-env stop",
    "env:status": "wp-env status",
    "env:logs": "wp-env logs",
    "env:cli": "wp-env run cli --env-cwd=wp-content/plugins/od-visual-regression wp",
    "lint:php": "composer lint",
    "format:php": "composer format",
    "i18n:pot": "wp-env run cli --env-cwd=wp-content/plugins/od-visual-regression wp i18n make-pot . languages/od-visual-regression.pot --domain=od-visual-regression",
    "i18n:mo": "wp-env run cli --env-cwd=wp-content/plugins/od-visual-regression wp i18n make-mo languages",
    "build": "npm run build --workspace=@odvr/shared && npm run build --workspace=@odvr/runner && npm run build --workspace=@odvr/dispatcher",
    "test": "npm run build && node --test apps/runner/tests/*.test.mjs && npm run test:dispatcher",
    "runner": "node apps/runner/dist/index.js",
    "schemas:validate": "node scripts/validate-schemas.mjs && node scripts/generate-contract-types.mjs --check",
    "preenv:start": "node scripts/sync-schemas.mjs",
    "test:contracts": "node --test packages/schemas/tests/*.test.mjs",
    "runner:job": "node apps/runner/dist/job.js",
    "test:dispatcher": "node --test apps/dispatcher/tests/*.test.mjs",
    "dispatcher": "node apps/dispatcher/dist/index.js",
    "images:build": "node infra/scripts/build-images.mjs",
    "local:start": "node infra/scripts/local.mjs start",
    "local:fixture": "node infra/scripts/local.mjs fixture",
    "local:status": "node infra/scripts/local.mjs status",
    "local:stop": "node infra/scripts/local.mjs stop",
    "local:check": "node infra/scripts/local.mjs check",
    "test:local": "node infra/scripts/test-local.mjs",
    "cloud:plan": "node infra/scripts/cloud-plan.mjs",
    "test:cloud-plan": "node --test infra/cloud/*.test.mjs",
    "cloud:deployment-plan": "node infra/scripts/cloud-deployment-plan.mjs"
  },
  "devDependencies": {
    "@wordpress/env": "^11.17.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
